# ==========================================
# Saarthi Finance — Environment Variables
# Copy this file to .env and fill in values
# Do NOT commit .env to git
# ==========================================

# --- Frontend (apps/web/.env) ---
VITE_API_URL=http://localhost:8000        # Backend base URL
VITE_USE_MOCK=false                       # Set to true for offline/demo mode

# --- Backend (apps/api/.env) ---
DATABASE_URL=                             # Leave empty to use SQLite (auto-created at apps/api/saarthi.db)
JWT_SECRET=saarthi-dev-secret-change-in-production
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- AI Assistant (optional) ---
LLM_API_KEY=                              # OpenAI-compatible API key; fallback templates used if empty

# --- Supabase (production only) ---
SUPABASE_URL=
SUPABASE_KEY=
