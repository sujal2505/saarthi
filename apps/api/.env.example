# =============================================
# Saarthi Finance — Backend Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Database connection string
# SQLite (local dev):
DATABASE_URL=sqlite:///./saarthi.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://saarthi:saarthi@localhost:5432/saarthi

# CORS allowed origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT configuration
JWT_SECRET=saarthi-demo-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM API key for the Ask Saarthi assistant
# Uses Google Gemini (gemini-2.0-flash) — get a key at https://aistudio.google.com/
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
